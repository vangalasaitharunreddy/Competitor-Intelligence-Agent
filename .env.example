# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model alias to use for structured reasoning and synthesis (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# HINDSIGHT_BASE_URL: Hindsight persistent AI memory API base URL (e.g. https://api.hindsight.vectorize.io or self-hosted)
HINDSIGHT_BASE_URL="https://api.hindsight.vectorize.io"

# HINDSIGHT_API_KEY: API key for Hindsight memory operations
HINDSIGHT_API_KEY="MY_HINDSIGHT_API_KEY"

# DATABASE_URL: Optional PostgreSQL connection string for durable production storage.
# If omitted, CompetitorLens defaults to the embedded SQLite preview storage with explicit UI labels.
DATABASE_URL="postgresql://user:password@localhost:5432/competitorlens"

# SESSION_SECRET: Secret for signing workspace session tokens
SESSION_SECRET="your-secure-session-secret"

# SCHEDULER_SECRET: Secret for authorizing external scheduled monitoring pings (/api/scheduler/trigger)
SCHEDULER_SECRET="your-scheduler-secret"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
